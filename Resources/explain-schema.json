{
  "type": "object",
  "additionalProperties": false,
  "required": ["point", "detail", "action", "terms", "is_question"],
  "properties": {
    "point": { "type": "string", "maxLength": 80 },
    "detail": { "type": "string", "minLength": 60, "maxLength": 900 },
    "action": { "type": "string", "maxLength": 300 },
    "terms": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "meaning"],
        "properties": {
          "term": { "type": "string", "maxLength": 60 },
          "meaning": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "is_question": { "type": "boolean" }
  }
}
